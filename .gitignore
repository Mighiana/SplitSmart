# Dart/Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml

# NOTE: debug-symbols/ is intentionally COMMITTED (not ignored). Those files
# decode obfuscated crash reports and are small (~15 MB/release); keeping them
# in the private repo means they can never be lost and always match a release.

# Build/JVM crash logs & temp working files
hs_err_pid*.log
android/hs_err_pid*.log
*.hprof
analyze_output.txt
fix_dropdowns.py
fix_pft.py

# Claude Code agent worktrees / local sessions
.claude/

# Android
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/

# iOS
ios/Flutter/.last_build_id
ios/Pods/
ios/.symlinks/
ios/Flutter/flutter_export_environment.sh

# VS Code
.vscode/

# IntelliJ IDEA
.idea/

# macOS
.DS_Store

# Environment files
.env
.env.*

# Local SQLite database (don't commit user data)
*.db
*.db-shm
*.db-wal

# Release keystore — never commit credentials
*.jks
*.keystore
key.properties

# Node (Cloud Functions + Firestore rules tests)
node_modules/

# Firebase CLI / emulator artifacts
*-debug.log
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
.runtimeconfig.json
