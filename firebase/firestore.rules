rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    // True when the caller signed in anonymously (a "guest").
    function isAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    // True when the caller holds the server-set premium custom claim.
    function hasPremium() {
      return request.auth != null && request.auth.token.premium == true;
    }
    // True when this group write changes the premium (guest-access) flag.
    // Uses .get(..., false) so LEGACY groups without the field don't error.
    function premiumFlagChanged() {
      return request.resource.data.get('isPremiumGroup', false)
          != resource.data.get('isPremiumGroup', false);
    }
    // A field is unchanged between the stored doc and the incoming write.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    // SEC-C3: validate a money amount written by a (tamperable) client.
    function validAmount(v) {
      return v is number && v >= 0 && v <= 1000000000;
    }
    // SEC-C3: validate an expense document's client-supplied fields.
    function validExpense() {
      return validAmount(request.resource.data.amount)
          && request.resource.data.get('desc', '') is string
          && request.resource.data.get('desc', '').size() <= 200
          && request.resource.data.get('paidBy', '') is string
          && request.resource.data.get('paidBy', '').size() <= 100;
    }
    // SEC-C3: validate a settlement document's client-supplied fields.
    function validSettlement() {
      return validAmount(request.resource.data.amount)
          && request.resource.data.get('from', '') is string
          && request.resource.data.get('from', '').size() <= 100
          && request.resource.data.get('to', '') is string
          && request.resource.data.get('to', '').size() <= 100;
    }
    // SEC-C4: shared group document shape limits. Rules cannot prove every
    // nested value is perfect, but they can prevent obvious bloat/tampering.
    function validGroupShape() {
      return request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() <= 50
          && request.resource.data.get('members', []) is list
          && request.resource.data.get('members', []).size() <= 50
          && request.resource.data.get('emoji', '') is string
          && request.resource.data.get('emoji', '').size() <= 16
          && request.resource.data.get('currency', '') is string
          && request.resource.data.get('currency', '').size() <= 8
          && request.resource.data.get('sym', '') is string
          && request.resource.data.get('sym', '').size() <= 8;
    }
    // Fields that an invite-code join or self-leave must not alter.
    function groupProfileUnchanged() {
      return unchanged('name')
          && unchanged('emoji')
          && unchanged('currency')
          && unchanged('sym')
          && unchanged('isArchived')
          && unchanged('createdAt');
    }
    // Owner-only invite mapping create. Prevents code squatting/rewrites.
    function validInviteCodeMapping(code) {
      return request.auth != null
          && request.resource.data.keys().hasOnly(['groupId'])
          && request.resource.data.groupId is string
          && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
          && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid
          && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;
    }
    function allowedUserSubcollection(name) {
      return name in [
        'transactions',
        'wallets',
        'groupWallets',
        'budgetLimits',
        'reminders',
        'savingGoals'
      ];
    }
    function validPurchaseQueueWrite() {
      return request.resource.data.keys().hasOnly([
            'store',
            'productId',
            'token',
            'createdAt',
            'status'
          ])
          && request.resource.data.store in ['play', 'appstore']
          && request.resource.data.productId in [
            'splitsmart_premium_monthly',
            'splitsmart_premium_yearly'
          ]
          && request.resource.data.token is string
          && request.resource.data.token.size() <= 8192
          && request.resource.data.get('status', 'pending') == 'pending';
    }
    function validSupportTicket() {
      return request.resource.data.get('message', '') is string
          && request.resource.data.get('message', '').size() <= 5000
          && request.resource.data.get('type', '') is string
          && request.resource.data.get('type', '').size() <= 60
          && request.resource.data.get('fromEmail', '') is string
          && request.resource.data.get('fromEmail', '').size() <= 320;
    }

    // ─── User Private Data ──────────────────────────────────────────────────
    // Each user can only read/write their own document and subcollections.
    //
    // NOTE on `entitlement`: clients can write their own user doc, so the
    // `entitlement` field is treated as a NON-authoritative UX mirror only.
    // The authoritative premium signal is the `premium` CUSTOM CLAIM, which
    // only the verifyPurchase Cloud Function (Admin SDK) can set. Every
    // security-relevant check (hasPremium() below) reads the claim, so a client
    // faking `entitlement.premium=true` gains nothing — enabling guest access
    // (isPremiumGroup) still fails without the claim.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // SEC: cap fcmTokens so a client cannot write an unbounded array.
      // The app keeps <= 5 tokens; 25 leaves headroom for arrayUnion+prune.
      allow write: if request.auth != null && request.auth.uid == userId
                   && (
                     !('fcmTokens' in request.resource.data)
                     || (
                       request.resource.data.fcmTokens is list
                       && request.resource.data.fcmTokens.size() <= 25
                     )
                   );

      match /purchaseQueue/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && validPurchaseQueueWrite();
        allow update: if false;
      }

      match /support_tickets/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && validSupportTicket();
        allow update, delete: if false;
      }

      // Personal subcollections: owner-only and explicitly enumerated so a
      // client cannot create arbitrary backend namespaces under users/{uid}.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId
                           && allowedUserSubcollection(subcollection);
      }
    }

    // ─── Groups ──────────────────────────────────────────────────────────────
    // Only group members can read/write group data.
    // Any authenticated (non-guest) user can create a new group.
    // Joining resolves invite codes via the resolveInvite Cloud Function;
    // direct group reads are member/creator-only.
    match /groups/{groupId} {

      // SEC-C2: Create requires a non-guest caller AND a well-formed document:
      //  - createdBy must be the caller (no forging ownership),
      //  - the caller must be in memberUids, with a sane member cap,
      //  - guest access (isPremiumGroup) cannot be enabled at creation unless
      //    the caller actually holds the premium claim,
      //  - name/members are bounded strings/lists.
      allow create: if request.auth != null && !isAnon()
                    && request.resource.data.createdBy == request.auth.uid
                    && validGroupShape()
                    && request.resource.data.memberUids is list
                    && request.auth.uid in request.resource.data.memberUids
                    && request.resource.data.memberUids.size() <= 50
                    && (request.resource.data.get('isPremiumGroup', false) == false
                        || hasPremium());

      // SEC: get is members/creator only. Invite resolution (the old reason
      // for a public get) now goes through the `resolveInvite` Cloud Function,
      // so knowing a group ID no longer exposes its metadata.
      allow get: if request.auth != null
                 && (
                   request.auth.uid in resource.data.get('memberUids', [])
                   || resource.data.createdBy == request.auth.uid
                 );

      // Allow list if the user is a member of the group OR created it (legacy fallback)
      allow list: if request.auth != null
                  && (
                    request.auth.uid in resource.data.memberUids
                    || resource.data.createdBy == request.auth.uid
                    || !("memberUids" in resource.data) && resource.data.createdBy == request.auth.uid
                  );

      // Delete only by the creator.
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;

      // SEC-C1/C2: createdBy + inviteCode are IMMUTABLE on every update. Then:
      //  (a) only the CREATOR may edit the group (name/emoji/members/premium);
      //  (b) invite-code join adds exactly the caller's own uid;
      //  (c) any member may LEAVE by removing only their own uid.
      allow update: if request.auth != null
                    && unchanged('createdBy')
                    && unchanged('inviteCode')
                    && (
                      // (a) CREATOR edits the group. Enabling the premium
                      //     (guest-access) flag additionally requires the claim.
                      (
                        resource.data.createdBy == request.auth.uid
                        && validGroupShape()
                        // Owner edits may remove members, but invite-code join
                        // is the only client path that may add member UIDs.
                        && request.resource.data.memberUids.hasOnly(resource.data.memberUids)
                        && (
                          !premiumFlagChanged()
                          || request.resource.data.get('isPremiumGroup', false) == false
                          || hasPremium()
                        )
                      )
                      // (b) Invite-code join: adds exactly the caller's own uid.
                      || (
                        !(request.auth.uid in resource.data.memberUids)
                        && groupProfileUnchanged()
                        && validGroupShape()
                        && request.resource.data.joinAttemptCode == resource.data.inviteCode
                        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
                        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
                        && request.auth.uid in request.resource.data.memberUids
                        && request.resource.data.memberUids.size() <= 50
                        // GUEST GATE: anonymous joiners require a premium group.
                        && (!isAnon() || resource.data.get('isPremiumGroup', false) == true)
                        // Joiners must never flip the premium flag.
                        && !premiumFlagChanged()
                      )
                      // (c) Self-leave: caller removes ONLY their own uid (no
                      //     additions, exactly one removal = themselves).
                      || (
                        groupProfileUnchanged()
                        && validGroupShape()
                        && request.auth.uid in resource.data.memberUids
                        && !(request.auth.uid in request.resource.data.memberUids)
                        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
                        && request.resource.data.memberUids.hasOnly(resource.data.memberUids)
                        && !premiumFlagChanged()
                      )
                    );

      // Expenses subcollection — members only, enforce authorship + valid data.
      match /expenses/{expenseId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow create: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                    && request.resource.data.addedBy == request.auth.uid
                    && validExpense();
        // Update: expense author OR group creator can edit (with valid data).
        allow update: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                    && validExpense()
                    && unchanged('addedBy')
                    && (
                      !("addedBy" in resource.data)
                      || resource.data.addedBy == request.auth.uid
                      || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
                    );
        // Delete: expense author OR group creator (enables group deletion batch)
        allow delete: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                    && (
                      !("addedBy" in resource.data)
                      || resource.data.addedBy == request.auth.uid
                      || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
                    );
      }

      // SEC-C3: Settlements — members only, enforce addedBy + valid amounts.
      match /settlements/{settlementId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                      && request.resource.data.addedBy == request.auth.uid
                      && validSettlement();
        // Update/Delete: only the recorder (addedBy) or the group creator — a
        // member can't tamper with someone else's settlement to skew balances.
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                      && validSettlement()
                      && unchanged('addedBy')
                      && (
                        !("addedBy" in resource.data)
                        || resource.data.addedBy == request.auth.uid
                        || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
                      );
        allow delete: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                      && (
                        !("addedBy" in resource.data)
                        || resource.data.addedBy == request.auth.uid
                        || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
                      );
      }
    }

    // ─── Invite Codes ────────────────────────────────────────────────────────
    // SEC-C5: Secure invite code resolution without collection scraping.
    match /inviteCodes/{code} {
      // SEC: resolution happens in the resolveInvite Cloud Function (Admin
      // SDK bypasses rules); clients never need to read mappings directly.
      allow get: if false;
      allow create: if validInviteCodeMapping(code);
      allow update, delete: if false;
    }

    // ─── Support Tickets (legacy top-level) ──────────────────────────────────
    // The app writes support tickets under users/{uid}/support_tickets (owner-
    // only). This top-level path is kept for compatibility but is tightened:
    // the caller must stamp their own uid and stay within size limits.
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null
                    && request.resource.data.get('uid', '') == request.auth.uid
                    && request.resource.data.get('message', '') is string
                    && request.resource.data.get('message', '').size() <= 5000
                    && request.resource.data.get('type', '') is string
                    && request.resource.data.get('type', '').size() <= 60;
    }

    // ─── Connectivity probe ──────────────────────────────────────────────────
    // The in-app "Run Ping Test" diagnostic reads ping/status to confirm the
    // device can reach Firestore. Read-only, signed-in users only, single-doc
    // get (no list = no enumeration), no writes. Exposes nothing sensitive —
    // it's a dedicated health-check marker. Without this, default-deny made the
    // ping fail and falsely report "Connectivity: Failed".
    match /ping/{docId} {
      allow get: if request.auth != null;
    }

    // ─── Default deny ────────────────────────────────────────────────────────
    // Everything else is denied by default (Firestore's default behavior).
  }
}
